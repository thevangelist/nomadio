server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Deploy-time config and the service worker must never be served stale.
  location = /config.json { add_header Cache-Control "no-store"; }
  location = /sw.js       { add_header Cache-Control "no-store"; }

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }

  location /api/ {
    # Resolved at request time, not at startup: a static proxy_pass makes nginx
    # refuse to boot whenever the collector is down, which would take the
    # dashboard with it exactly when it is needed to say the collector is down.
    resolver ${NOMADIO_RESOLVER} valid=10s ipv6=off;
    set $upstream ${NOMADIO_API_UPSTREAM};
    proxy_pass $upstream;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }

  location / { try_files $uri /index.html; }
}
