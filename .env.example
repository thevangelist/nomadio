# ---- Backend ----
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*                       # comma-separated origins in production

POLL_INTERVAL_MS=1000               # how often providers are polled

# mock | srt | nginx-rtmp
STREAM_PROVIDER=mock
SRT_STATS_URL=http://127.0.0.1:8181/stats
NGINX_RTMP_STATS_URL=http://127.0.0.1:8080/stat
STREAM_APP=live                     # nginx-rtmp application name
STREAM_KEY=                         # stream key / SRT streamid; empty = first publisher

# single | none   (V2 replaces this with the Speedify agent)
NETWORK_PROVIDER=single

TELEMETRY_TOKEN=change-me           # required in the Shortcut's Authorization header
DEVICE_STALE_MS=120000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:4000
